DATABASE_URL="postgresql://postgres:postgres@localhost:5432/travel_planner?schema=public"
PORT=3000
# Generate a real secret for anything beyond local dev, e.g.: openssl rand -base64 32
JWT_SECRET=dev-only-change-me

# Used to build links in emails (password reset, trip invites).
FRONTEND_URL=http://localhost:5173

# Optional: leave SMTP_HOST unset to log emails to the console instead of
# sending them (fine for local dev). Set all of these to send real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Cuti <no-reply@cuti.app>"
