DATABASE_URL="postgresql://postgres:postgres@localhost:5432/travel_planner?schema=public"
PORT=3000
# Generate a real secret for anything beyond local dev, e.g.: openssl rand -base64 32
JWT_SECRET=dev-only-change-me

# Encrypts sensitive profile fields (passport number) at rest. 32 random bytes,
# base64: openssl rand -base64 32. Losing it makes saved passport numbers
# unrecoverable, so back it up. Changing it breaks existing values.
FIELD_ENCRYPTION_KEY=ZGV2LW9ubHktY2hhbmdlLW1lZGV2LW9ubHktY2hhbmc=

# Used to build links in emails (password reset, trip invites).
FRONTEND_URL=http://localhost:5173

# Optional: leave SMTP_HOST unset to log emails to the console instead of
# sending them (fine for local dev). Set all of these to send real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Cuti <no-reply@cuti.app>"

# Deployment only. Leave both unset for local dev.
# Number of proxies in front of the app (e.g. 1 on Render), so the auth rate
# limit sees each visitor's real IP instead of the proxy's.
TRUST_PROXY=
# Comma-separated browser origins allowed to call the API, e.g. the deployed
# web app: https://cuti.pages.dev. Unset allows any origin.
CORS_ORIGINS=
