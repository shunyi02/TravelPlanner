generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String              @id @default(uuid())
  email         String              @unique
  name          String
  avatarUrl     String?
  passwordHash  String
  /** A member added by name (optionally email) without registering. Can log
   *  in normally once someone registers with this user's email — see
   *  AuthService.register. */
  isPlaceholder Boolean             @default(false)
  trips         TripMember[]
  expensesPaid  Expense[]           @relation("PaidBy")
  splits        ExpenseSplit[]
  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]
  createdAt     DateTime            @default(now())
}

model Trip {
  id        String       @id @default(uuid())
  name      String
  startDate DateTime?
  endDate   DateTime?
  coverPhoto String?
  /** ISO 4217 code (e.g. "USD"). Every expense on this trip is logged in
   *  this currency — Balances has no cross-currency conversion. */
  currency  String       @default("USD")
  /** The trip's city/area, geocoded once at creation (or later via update)
   *  — powers the "suggest places to visit" panel. Optional: a trip with
   *  no destination just doesn't get suggestions. */
  destinationName String?
  destinationLat  Float?
  destinationLng  Float?
  members   TripMember[]
  places    Place[]
  accommodations Accommodation[]
  expenses  Expense[]
  invites   TripInvite[]
  createdAt DateTime     @default(now())
}

// A pending invite for someone who isn't a user yet. Consumed (turned into a
// TripMember) automatically when they register with this email — see
// AuthService.register.
model TripInvite {
  id        String   @id @default(uuid())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId    String
  email     String
  invitedBy String
  createdAt DateTime @default(now())

  @@unique([tripId, email])
}

model TripMember {
  id     String @id @default(uuid())
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  role   String @default("member") // owner | member

  @@unique([tripId, userId])
}

enum PlaceType {
  STOP
  HOTEL
  FLIGHT
}

model Place {
  id        String    @id @default(uuid())
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId    String
  type      PlaceType @default(STOP)
  name      String
  lat       Float?
  lng       Float?
  visitDate DateTime?
  order     Int?
  notes     String?
  // flight-only
  departureTime DateTime?
  arrivalTime   DateTime?
  departureAirport String?
  arrivalAirport   String?
  // hotel-only
  checkIn   DateTime?
  checkOut  DateTime?
}

model Accommodation {
  id           String   @id @default(uuid())
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId       String
  name         String
  checkInDate  DateTime // day guest may occupy room
  checkOutDate DateTime // day guest must leave; next stay's checkInDate may equal this same day
  notes        String?
}

model Expense {
  id          String         @id @default(uuid())
  trip        Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId      String
  description String
  amount      Decimal        @db.Decimal(12, 2)
  currency    String         @default("USD")
  /** Pre-tax amount actually entered, when servicePct/taxPct were used to
   *  compute `amount`. Null for a plain expense with no breakdown (amount
   *  is the whole story). Kept only to repopulate the edit form's fields —
   *  `amount` (the compounded total) is still what balances/splits use. */
  subtotal    Decimal?       @db.Decimal(12, 2)
  servicePct  Decimal?       @db.Decimal(5, 2)
  taxPct      Decimal?       @db.Decimal(5, 2)
  /** Free-form-ish label from a curated list (EXPENSE_CATEGORIES in the
   *  shared package) — a plain string like Trip.currency, not a DB enum, so
   *  adding a category later doesn't need a migration. */
  category    String         @default("Other")
  /** When the expense actually happened, as chosen by whoever logs it —
   *  distinct from createdAt (when the row was inserted). Expenses are
   *  listed ordered by this field. */
  expenseDate DateTime       @default(now())
  paidBy      User           @relation("PaidBy", fields: [paidById], references: [id])
  paidById    String
  splits      ExpenseSplit[]
  createdAt   DateTime       @default(now())
}

model ExpenseSplit {
  id         String  @id @default(uuid())
  expense    Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId  String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  amountOwed Decimal @db.Decimal(12, 2)
  settled    Boolean @default(false)

  @@unique([expenseId, userId])
}

// Refresh tokens are stored as a SHA-256 hash, never the raw token, same
// principle as passwords. Rotated on every use (see AuthService.refresh).
model RefreshToken {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Single-use, short-lived tokens for the forgot-password flow.
model PasswordResetToken {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}
