{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      // src/icons.ts imports single Phosphor icons from their .tsx source (to keep the bundle small);
      // type-check against the package's published declarations instead of that source.
      "phosphor-react-native/src/icons/*": ["../../node_modules/phosphor-react-native/lib/typescript/icons/*"]
    }
  }
}
